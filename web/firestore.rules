rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each quest is stored at users/{accountId}/quests/{questId}.
    // All fields are required. Only `completed` and `focusMinutes` may change after creation.
    function ownsAccount(accountId) {
      return request.auth != null && request.auth.uid == accountId;
    }

    function isValidQuest(data) {
      return data.keys().hasOnly([
          'title', 'description', 'category', 'dueDate', 'completed', 'focusMinutes', 'createdAt', 'order', 'subtasks'
        ])
        && data.keys().hasAll([
          'title', 'description', 'category', 'dueDate', 'completed', 'focusMinutes', 'createdAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.description is string
        && data.description.size() <= 1000
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 80
        && data.dueDate is string
        && data.dueDate.matches('^$|^\\d{4}-\\d{2}-\\d{2}$')
        && data.completed is bool
        && data.focusMinutes is int
        && data.focusMinutes >= 0
        && data.createdAt is number
        && (!data.keys().hasAny(['order']) || data.order is int)
        && (!data.keys().hasAny(['subtasks']) || data.subtasks is list);
    }

    // Allowed updates: editable quest fields, completion/focus state, and order.
    // `focusMinutes` must be an integer and cannot decrease (monotonic non-negative).
    // Note: The monotonic rule prevents decreases, but cannot prove a client truly
    // studied that duration. This is an intentional trust-the-client tradeoff for
    // this personal study timer application.
    function isValidQuestUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'category', 'dueDate', 'completed', 'focusMinutes', 'order', 'subtasks'
        ])
        && request.resource.data.completed is bool
        && request.resource.data.focusMinutes is int
        && request.resource.data.focusMinutes >= resource.data.focusMinutes
        && request.resource.data.focusMinutes >= 0
        && (!request.resource.data.keys().hasAny(['order']) || request.resource.data.order is int)
        && (!request.resource.data.keys().hasAny(['subtasks']) || request.resource.data.subtasks is list);
    }

    match /users/{accountId}/quests/{questId} {
      allow read, delete: if ownsAccount(accountId);
      allow create: if ownsAccount(accountId)
        && isValidQuest(request.resource.data)
        && request.resource.data.completed == false
        && request.resource.data.focusMinutes == 0;
      allow update: if ownsAccount(accountId)
        && isValidQuest(request.resource.data)
        && isValidQuestUpdate();
    }

    match /users/{accountId}/periods/{periodId} {
      allow read, write: if ownsAccount(accountId);
    }

    match /users/{accountId}/journal/{entryId} {
      allow read, write: if ownsAccount(accountId);
    }

    match /users/{accountId}/focusSessions/{sessionId} {
      allow read, write: if ownsAccount(accountId);
    }
  }
}
